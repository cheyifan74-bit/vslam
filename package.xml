<?xml version="1.0"?>
<package format="3">

  <name>vslam</name>
  <version>0.1.0</version>
  <description>VSLAM system — ROS wrapper + application layer on top of OpenVINS</description>

  <author email="cheyifan@example.com">che yifan</author>
  <maintainer email="cheyifan@example.com">che yifan</maintainer>
  <license>BSD</license>

  <!-- ROS1 -->
  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 1">tf</depend>

  <!-- ROS2 -->
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">tf2_ros</depend>
  <depend condition="$ROS_VERSION == 2">tf2_geometry_msgs</depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rviz2</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ros2bag</exec_depend>

  <!-- Both -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>image_transport</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>

  <depend>ov_core</depend>
  <depend>ov_msckf</depend>
  <depend>ov_init</depend>

  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>boost</depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>

</package>
